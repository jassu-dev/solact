# ==========================================
# PRODUCTION ENVIRONMENT VARIABLES
# ==========================================

# Domain configuration (your GoDaddy domain)
DOMAIN=yourdomain.com

# PostgreSQL Database
POSTGRES_USER=solact_founder
POSTGRES_PASSWORD=generate-a-strong-password-here
POSTGRES_DB=shopify_ai

# Chatwoot Secrets
CHATWOOT_SECRET=generate-a-random-64-char-hex-secret
CHATWOOT_API_TOKEN=solact_ai_bot_token_123456789

# AI & LLM API Keys
LLM_API_KEY=AIzaSy...your-gemini-key
LLM_MODEL=gemini-2.5-flash

# Shopify Partner App Keys
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
