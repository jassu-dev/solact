solact.in {
    handle /api/* {
        reverse_proxy api:8000
    }
    handle {
        reverse_proxy dashboard:3001
    }
}

www.solact.in {
    redir https://solact.in{uri} permanent
}

app.solact.in {
    handle /api/* {
        reverse_proxy api:8000
    }
    handle {
        reverse_proxy dashboard:3001
    }
}

api.solact.in {
    reverse_proxy api:8000
}

chat.solact.in {
    reverse_proxy chatwoot-web:3000
}

solact.localhost {
    handle /api/* {
        reverse_proxy api:8000
    }
    handle {
        reverse_proxy dashboard:3001
    }
}

api.solact.localhost {
    reverse_proxy api:8000
}

chatwoot.solact.localhost {
    reverse_proxy chatwoot-web:3000
}

:80 {
    handle /api/* {
        reverse_proxy api:8000
    }
    handle {
        reverse_proxy dashboard:3001
    }
}
